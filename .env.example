# Copy these exports into your shell, or save them in .env and source it.
export DISCORD_TOKEN=''
export DISCORD_SYNC_TOKEN_2=''
export DISCORD_SYNC_TOKEN_3=''
export LAVALINK_URI='http://localhost:2333'
export LAVALINK_PASSWORD='youshallnotpass'
# YouTube signature helper; can be replaced with a self-hosted yt-cipher URL.
export YOUTUBE_CIPHER_URL='https://cipher.kikkia.dev/'
export YOUTUBE_CIPHER_PASSWORD=''
export DB_BACKUP_DIR='backups'
export DB_BACKUP_HOURS='6'
export DB_BACKUP_KEEP='28'
export ADMIN_USERNAME='admin'
export ADMIN_PASSWORD='replace-with-a-long-password'
export FLASK_SECRET_KEY='replace-with-a-long-random-value'
# Optional LavaSrc platforms; also exported to the Java process.
export SPOTIFY_ENABLED='false'
export SPOTIFY_CLIENT_ID=''
export SPOTIFY_CLIENT_SECRET=''
export APPLE_MUSIC_ENABLED='false'
export APPLE_MUSIC_TOKEN=''
export APPLE_MUSIC_COUNTRY='US'
# Register optional /play, /radio, /queue, /history and playback slash commands.
export ENABLE_SLASH_COMMANDS='false'

# Discord website login. Fill all four values to enable it.
# This client secret is from OAuth2 in the developer portal, not the bot token.
export DISCORD_OAUTH_CLIENT_ID=''
export DISCORD_OAUTH_CLIENT_SECRET=''
export DISCORD_OAUTH_REDIRECT_URI=''
# Comma-separated user IDs, including your own. Add people here and restart the dashboard.
export DISCORD_ALLOWED_USER_IDS=''
export DASHBOARD_LOGIN_DAYS='30'
# Public HTTPS deployment: set true. Leave false for localhost HTTP.
export FLASK_COOKIE_SECURE='false'
