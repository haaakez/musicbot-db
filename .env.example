# Copy these exports into your shell, or save them in .env and source it.
export DISCORD_TOKEN=''
export DISCORD_SYNC_TOKEN_2=''
export DISCORD_SYNC_TOKEN_3=''
export LAVALINK_URI='http://localhost:2333'
export LAVALINK_PASSWORD='youshallnotpass'
export ADMIN_USERNAME='admin'
export ADMIN_PASSWORD='replace-with-a-long-password'
export FLASK_SECRET_KEY='replace-with-a-long-random-value'
# Optional LavaSrc platforms; also exported to the Java process.
export SPOTIFY_ENABLED='false'
export SPOTIFY_CLIENT_ID=''
export SPOTIFY_CLIENT_SECRET=''
export APPLE_MUSIC_ENABLED='false'
export APPLE_MUSIC_TOKEN=''
export APPLE_MUSIC_COUNTRY='US'

# Download YouTube audio locally; avoids broken Lavalink stream resolution.
export YOUTUBE_CACHE_ENABLED='true'
export YOUTUBE_CACHE_MB='1024'
